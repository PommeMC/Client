#version 450
layout(local_size_x = 1) in;
layout(constant_id = 0) const uint MAX_TASK_X = 1u;

struct TaskCommand { uint x; uint y; uint z; };
struct CandidateCount { uint count; uint capacity; };
layout(set=0,binding=3) readonly buffer SolidCount { CandidateCount solid; };
layout(set=0,binding=5) readonly buffer CutoutCount { CandidateCount cutout; };
layout(set=0,binding=24) writeonly buffer SolidCommand { TaskCommand solid_command; };
layout(set=0,binding=25) writeonly buffer CutoutCommand { TaskCommand cutout_command; };

TaskCommand commandFor(CandidateCount candidates) {
    uint count = min(candidates.count, candidates.capacity);
    if (count == 0u) return TaskCommand(0u, 1u, 1u);
    uint x = min(count, MAX_TASK_X);
    return TaskCommand(x, (count + x - 1u) / x, 1u);
}

void main() {
    solid_command = commandFor(solid);
    cutout_command = commandFor(cutout);
}

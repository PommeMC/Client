#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const bool TASK_BACKEND = false;
#include "chunk_meta.glsl"
#include "frustum.glsl"

const uint BATCH_WORDS = 16u;
struct DrawCmd { uint x; uint y; uint z_or_first; uint batch; };
layout(set=0,binding=0) readonly buffer Meta { ChunkMeta chunks[]; };
layout(set=0,binding=2) writeonly buffer SeedSolid { DrawCmd seed_solid[]; };
layout(set=0,binding=3) buffer SeedSolidCount { uint seed_solid_count; };
layout(set=0,binding=4) writeonly buffer SeedCutout { DrawCmd seed_cutout[]; };
layout(set=0,binding=5) buffer SeedCutoutCount { uint seed_cutout_count; };
layout(set=0,binding=13) buffer History { uint history[]; };
layout(set=0,binding=18) buffer WaterBuckets { uint water_buckets[]; };
layout(set=0,binding=19) writeonly buffer WaterCandidates { uint water_candidates[]; };
layout(set=0,binding=22) readonly buffer MeshBuf { uint mesh_data[]; };
layout(set=0,binding=23) buffer Stats { uint visible_sections; uint seed_sections; uint new_sections; uint _s; };
#include "batch_cull.glsl"

void emit(uint word, bool cutout) {
    if (!TASK_BACKEND && batch_backfacing(word)) return;
    uint faces = batch_face_count(word);
    DrawCmd d = TASK_BACKEND
        ? DrawCmd(0u, 0u, 0u, word)
        : DrawCmd(faces * 6u, 1u, 0u, word);
    // Let the count overflow the output allocation. Indirect draws clamp it
    // through maxDrawCount; task dispatch clamps it in task_dispatch.comp.
    // A global CAS loop here serializes every visible batch.
    uint out_index = cutout
        ? atomicAdd(seed_cutout_count, 1u)
        : atomicAdd(seed_solid_count, 1u);
    if (out_index < draw_capacity) {
        if (cutout) seed_cutout[out_index] = d; else seed_solid[out_index] = d;
    }
}

void enqueue_water(uint idx, ChunkMeta m) {
    if (m.fluid_batch_count == 0u) return;
    ivec3 sec = m.origin >> 4, cam = ivec3(cam_x, cam_y, cam_z) >> 4;
    int dist = abs(sec.x-cam.x)+abs(sec.y-cam.y)+abs(sec.z-cam.z);
    uint bucket = uint(int(WATER_BUCKETS)-1-min(dist,int(WATER_BUCKETS)-1));
    atomicAdd(water_buckets[bucket], m.fluid_batch_count);
    uint ci = atomicAdd(water_buckets[WATER_BUCKETS], 1u);
    water_candidates[ci] = (idx << 9) | bucket;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= chunk_count) return;
    ChunkMeta m = chunks[idx];
    uint batches = m.solid_batch_count + m.cutout_batch_count + m.fluid_batch_count;
    if (batches == 0u || !section_in_distance(m.origin) || !bounds_visible(m.origin,m.aabb_min,m.aabb_max)) {
        history[idx] = 0u; return;
    }
    bool previous = history[idx] == m.visibility_generation;
    if (occlusion_enabled == 0u) {
        history[idx] = m.visibility_generation;
        previous = true;
        atomicAdd(visible_sections, 1u);
        enqueue_water(idx, m);
    }
    if (!previous) return;
    atomicAdd(seed_sections, 1u);
    for (uint i=0u;i<m.solid_batch_count;++i) emit(m.batch_word_offset+i*BATCH_WORDS,false);
    for (uint i=0u;i<m.cutout_batch_count;++i) emit(m.batch_word_offset+(m.solid_batch_count+i)*BATCH_WORDS,true);
}

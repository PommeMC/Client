#version 450

layout(local_size_x = 64) in;

layout(constant_id = 0) const int MAX_RD = 64;
const int MAX_SIZE = MAX_RD * 2 + 1;

#include "chunk_meta.glsl"

struct DrawCmd {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0) readonly buffer MetaBuf {
    ChunkMeta chunks[];
};

layout(set = 0, binding = 1) uniform FrustumBuf {
    vec4 planes[6];
    uint chunk_count;
    // Camera block position plus the eye's small offset from it; the
    // origins are rebased in integer math so nothing here forms a large
    // float.
    int cam_x;
    int cam_y;
    int cam_z;
    float frac_x;
    float frac_y;
    float frac_z;
    // The Hi-Z visibility mask this dispatch reads (written last frame
    // by visibility.comp): the center/min-section it was computed with, and
    // whether the slot has ever been written (0 = fail open, skip the test).
    int mask_center_x;
    int mask_center_z;
    int mask_min_section;
    int mask_section_count;
    uint mask_valid;
    // Player column + render distance for the column cull (0 = off).
    int player_cx;
    int player_cz;
    uint limit_rd;
    uint _pad0;
};

layout(set = 0, binding = 2) writeonly buffer IndirectBuf {
    DrawCmd draws[];
};

layout(set = 0, binding = 3) buffer CountBuf {
    uint draw_count;
};

layout(set = 0, binding = 4) writeonly buffer IndirectCutoutBuf {
    DrawCmd cutout_draws[];
};

layout(set = 0, binding = 5) buffer CutoutCountBuf {
    uint cutout_draw_count;
};

// Per-column section bitset from visibility.comp; same ring layout as the CPU
// ChunkRing (slot = rem_euclid(MAX_SIZE) per axis).
layout(set = 0, binding = 6) readonly buffer VisMaskBuf {
    uint vis_mask[];
};

// Water ordering scratch: reverse-distance bucket counts, with the candidate
// counter one slot past them. The scan pass turns counts into offsets, the
// emit pass turns candidates into ordered draws.
layout(set = 0, binding = 7) buffer WaterBuckets {
    uint water_buckets[];
};

layout(set = 0, binding = 8) writeonly buffer WaterCandidates {
    // Packed (meta slot << 9) | bucket.
    uint water_candidates[];
};

// Emit one indexed draw of `quads` quads starting at `vertex_offset` against
// the shared quad index buffer. The per-instance attributes (origin + fade)
// come from meta entry `idx`, routed via first_instance.
void emit(uint quads, int vertex_offset, uint idx, bool cutout) {
    if (quads == 0u) return;
    DrawCmd d;
    d.index_count = quads * 6u;
    d.instance_count = 1u;
    d.first_index = 0u;
    d.vertex_offset = vertex_offset;
    d.first_instance = idx;
    if (cutout) {
        cutout_draws[atomicAdd(cutout_draw_count, 1u)] = d;
    } else {
        draws[atomicAdd(draw_count, 1u)] = d;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= chunk_count) return;

    ChunkMeta m = chunks[idx];
    if (m.solid_quads == 0u && m.cutout_quads == 0u && m.water_quads == 0u) return;

    // Columns beyond the render distance never draw.
    if (limit_rd > 0u) {
        int dx = abs((m.origin.x >> 4) - player_cx);
        int dz = abs((m.origin.z >> 4) - player_cz);
        if (uint(max(dx, dz)) > limit_rd) return;
    }

    vec3 base = vec3(m.origin - ivec3(cam_x, cam_y, cam_z))
        - vec3(frac_x, frac_y, frac_z);
    vec3 mn = base + m.aabb_min.xyz;
    vec3 mx = base + m.aabb_max.xyz;

    for (int i = 0; i < 6; i++) {
        vec4 p = planes[i];
        float d = p.x * (p.x >= 0.0 ? mx.x : mn.x)
                + p.y * (p.y >= 0.0 ? mx.y : mn.y)
                + p.z * (p.z >= 0.0 ? mx.z : mn.z)
                + p.w;
        if (d < 0.0) return;
    }

    // Hi-Z occlusion: drop the section only when the mask proves it hidden.
    // Out-of-window columns and out-of-range section layers fail open (the
    // mask's slots alias beyond +-MAX_RD of its own center).
    if (mask_valid != 0u) {
        int cx = m.origin.x >> 4;
        int cz = m.origin.z >> 4;
        int dy = (m.origin.y >> 4) - mask_min_section;
        if (abs(cx - mask_center_x) <= MAX_RD && abs(cz - mask_center_z) <= MAX_RD
            && dy >= 0 && dy < min(mask_section_count, 32)) {
            int rx = cx % MAX_SIZE;
            if (rx < 0) rx += MAX_SIZE;
            int rz = cz % MAX_SIZE;
            if (rz < 0) rz += MAX_SIZE;
            if ((vis_mask[rx * MAX_SIZE + rz] & (1u << uint(dy))) == 0u) return;
        }
    }

    // The vertex slice is grouped solid-first; the cutout draw rebases its
    // vertex_offset past the solid quads.
    emit(m.solid_quads, m.vertex_offset, idx, false);
    emit(m.cutout_quads, m.vertex_offset + int(m.solid_quads * 4u), idx, true);

    // Water joins the bucketed translucent list: reverse Manhattan distance
    // (in sections) as the sort key, so far buckets land first in the emit
    // pass's output and blending runs back-to-front.
    if (m.water_quads != 0u) {
        ivec3 sec = m.origin >> 4;
        ivec3 cam_sec = ivec3(cam_x, cam_y, cam_z) >> 4;
        int dist = abs(sec.x - cam_sec.x) + abs(sec.y - cam_sec.y) + abs(sec.z - cam_sec.z);
        int last = int(WATER_BUCKETS) - 1;
        uint bucket = uint(last - min(dist, last));
        atomicAdd(water_buckets[bucket], 1u);
        uint ci = atomicAdd(water_buckets[WATER_BUCKETS], 1u);
        water_candidates[ci] = (idx << 9) | bucket;
    }
}

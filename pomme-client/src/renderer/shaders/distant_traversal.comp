#version 450

// One iteration of the walk down the node tree, a level at a time. Each
// listed node is frustum and Hi-Z tested; a node still larger on screen than
// the split size steps into its children (or asks for them), the rest draw.
// Nodes hidden by the Hi-Z or just outside the view are walked and asked for
// all the same, only not drawn, so what a turn or a climb brings into view
// is already at the detail it needs (a departure: the reference walks only
// what it draws). The nodes pushed for the next iteration size its dispatch:
// a workgroup per 1 << TRAVERSAL_GROUP_BITS of them, capped at the queue's
// room (another departure: the reference adds a workgroup per push and
// writes past a full queue).

#define OUT_OF_BOUNDS 0xFFFFFFFFu

#define DISTANT_SET 0
#define SCENE_BINDING 0
#define RENDER_LIST_BINDING 2
#define RENDER_LIST_ACCESS
#include "distant_section.glsl"

#define LOCAL_SIZE (1 << TRAVERSAL_GROUP_BITS)
layout(local_size_x = LOCAL_SIZE) in;

// The nodes whose children the CPU should make, by packed key, after their
// count and the count of those out of sight among them.
layout(set = 0, binding = 1, std430) restrict buffer RequestQueue {
    uvec2 request_index;
    uvec2 request_queue[];
};

// Per node: the key, the mesh (24 bits) under the flags' low byte, the first
// child (24 bits) under the flags' high byte.
layout(set = 0, binding = 3, std430) restrict buffer NodeData {
    uvec4 nodes[];
};

// Per iteration, its dispatch size (`xyz`) and how many nodes it has.
layout(set = 0, binding = 4, std430) restrict buffer QueueMeta {
    uvec4 queue_meta[LEVELS];
};

layout(set = 0, binding = 5, std430) readonly restrict buffer QueueSource {
    uint queue_source[];
};

layout(set = 0, binding = 6, std430) writeonly restrict buffer QueueSink {
    uint queue_sink[];
};

layout(set = 0, binding = 7) uniform texture2D hiz;
layout(set = 0, binding = 8) uniform sampler hiz_sampler;

// Per node, the frame it was last drawn, for the cleaner.
layout(set = 0, binding = 9, std430) writeonly restrict buffer LastRenderFrame {
    uint last_render_frame[];
};

layout(push_constant) uniform TraversalPc {
    uint queue_index;
};

struct Node {
    uint id;
    uvec2 raw_pos;
    ivec3 pos;
    uint level;
    uint flags;
    uint mesh;
    uint child_ptr;
};

Node unpack_node(uint id) {
    uvec4 packed = nodes[id];
    Node node;
    node.id = id;
    node.raw_pos = packed.xy;
    node.level = lod_level(packed.xy);
    node.pos = lod_position(packed.xy);
    node.mesh = packed.z & 0xFFFFFFu;
    node.child_ptr = packed.w & 0xFFFFFFu;
    node.flags = (packed.z >> 24u) | ((packed.w >> 24u) << 8u);
    return node;
}

bool has_mesh(Node node) {
    return node.mesh != NULL_ID;
}

bool has_children(Node node) {
    return node.child_ptr != NULL_ID;
}

bool has_requested(Node node) {
    return (node.flags & 1u) != 0u;
}

uint child_count(Node node) {
    return ((node.flags >> 2u) & 7u) + 1u;
}

void mark_requested(inout Node node) {
    node.flags |= 1u;
    nodes[node.id].z |= 1u << 24u;
}

// This iteration's node for the invocation, or none past the queue's count
// or room (the scratch queues', which the top-level ids never pass).
uint current_node() {
    if (min(queue_meta[queue_index].w, MAX_LISTED) <= gl_GlobalInvocationID.x) {
        return OUT_OF_BOUNDS;
    }
    return queue_source[gl_GlobalInvocationID.x];
}

uint push_index;

uint workgroups(uint nodes) {
    return (min(nodes, MAX_LISTED) + LOCAL_SIZE - 1u) >> TRAVERSAL_GROUP_BITS;
}

// Room for `count` nodes in the next iteration, its dispatch grown by the
// workgroups they add; the pushes' ranges tile the queue, so the sizes sum
// to its workgroups.
void push_nodes_init(uint count) {
    // A coarser node than the iteration expects (a record not yet rewritten)
    // has no next iteration to push to.
    if (queue_index + 1u >= LEVELS) {
        push_index = MAX_LISTED;
        return;
    }
    uint index = atomicAdd(queue_meta[queue_index + 1u].w, count);
    uint added = workgroups(index + count) - workgroups(index);
    if (added != 0u) {
        atomicAdd(queue_meta[queue_index + 1u].x, added);
    }
    push_index = index;
}

// Past the queue's room, dropped.
void push_node(uint id) {
    if (push_index < MAX_LISTED) {
        queue_sink[push_index] = id;
    }
    push_index++;
}

// Frustum test against the near five planes; the far plane never cuts.
bool test_plane(vec4 plane, vec3 base, float size) {
    return dot(plane.xyz, base + mix(vec3(size), vec3(0.0), lessThan(plane.xyz, vec3(0.0)))) >= -plane.w;
}

bool outside_frustum(vec4 planes[6], vec3 base, float size) {
    return !(test_plane(planes[0], base, size) && test_plane(planes[1], base, size)
        && test_plane(planes[2], base, size) && test_plane(planes[3], base, size)
        && test_plane(planes[4], base, size));
}

// The node's box projected, its screen bounds and the summed area of its
// faces; whether it lies outside the view, and outside the wider view that
// is still requested.
vec3 min_bb = vec3(0.0);
vec3 max_bb = vec3(0.0);
bool frustum_culled = false;
bool request_culled = false;
float screen_size = 0.0;

// The node's corner relative to the camera's section, and to the camera.
vec3 section_relative(Node node) {
    return vec3(((node.pos << node.level) - camera_section) << 5);
}

float cross_mag(vec2 a, vec2 b) {
    return abs(a.x * b.y - b.x * a.y);
}

// NDC to the viewport's 0..1, depth as is.
vec3 to_screen(vec4 clip) {
    vec3 ndc = clip.xyz / clip.w;
    return vec3(ndc.xy * 0.5 + 0.5, ndc.z);
}

void setup_screenspace(Node node) {
    vec3 base = section_relative(node);
    vec3 eye_base = base - camera_sub_pos;
    float size = float(32 << node.level);
    frustum_culled = outside_frustum(frustum, eye_base, size);
    request_culled = frustum_culled && outside_frustum(request_frustum, eye_base, size);
    if (request_culled) {
        return;
    }
    vec4 P000 = distant_view_proj * vec4(base, 1.0);
    mat3x4 axis = mat3x4(distant_view_proj) * size;
    vec4 P100 = axis[0] + P000;
    vec4 P001 = axis[2] + P000;
    vec4 P101 = axis[2] + P100;
    vec4 P010 = axis[1] + P000;
    vec4 P110 = axis[1] + P100;
    vec4 P011 = axis[1] + P001;
    vec4 P111 = axis[1] + P101;

    vec3 p000 = to_screen(P000);
    vec3 p100 = to_screen(P100);
    vec3 p001 = to_screen(P001);
    vec3 p101 = to_screen(P101);
    vec3 p010 = to_screen(P010);
    vec3 p110 = to_screen(P110);
    vec3 p011 = to_screen(P011);
    vec3 p111 = to_screen(P111);

    // Both the near and the far corner's three faces, so halved.
    float area = 0.0;
    {
        vec2 A = p100.xy - p000.xy;
        vec2 B = p010.xy - p000.xy;
        vec2 C = p001.xy - p000.xy;
        area += cross_mag(A, B) + cross_mag(A, C) + cross_mag(C, B);
    }
    {
        vec2 A = p011.xy - p111.xy;
        vec2 B = p101.xy - p111.xy;
        vec2 C = p110.xy - p111.xy;
        area += cross_mag(A, B) + cross_mag(A, C) + cross_mag(C, B);
    }
    screen_size = area * 0.5;

    min_bb = min(min(min(p000, p100), min(p001, p101)), min(min(p010, p110), min(p011, p111)));
    max_bb = max(max(max(p000, p100), max(p001, p101)), max(max(p010, p110), max(p011, p111)));
    min_bb = clamp(min_bb, vec3(0.0), vec3(1.0));
    max_bb = clamp(max_bb, vec3(0.0), vec3(1.0));
}

// Hidden when the farthest Hi-Z texel the box covers lies before the box's
// nearest point, at the level where the box spans about two texels.
bool culled_by_hiz() {
    // A box over the whole screen is never culled.
    if (any(lessThan(abs(max_bb.xy - min_bb.xy - vec2(1.0)), vec2(0.000001)))) {
        return false;
    }
    ivec2 hiz_extent = ivec2(hiz_size >> 16u, hiz_size & 0xFFFFu);
    vec2 size = (max_bb.xy - min_bb.xy) * hiz_extent;
    float level = floor(log2(max(max(size.x, size.y), 1.0))) - 1.0;
    level = clamp(level, 0.0, float(textureQueryLevels(sampler2D(hiz, hiz_sampler)) - 1));
    int mip = int(level);
    hiz_extent = max(ivec2(1), hiz_extent >> mip);
    ivec2 high = min(ivec2(ceil(max_bb.xy * hiz_extent)), hiz_extent - 1);
    ivec2 low = ivec2(floor(min_bb.xy * hiz_extent));
    float farthest = -1.0;
    for (int x = low.x; x <= high.x; x++) {
        for (int y = low.y; y <= high.y; y++) {
            farthest = max(texelFetch(sampler2D(hiz, hiz_sampler), ivec2(x, y), mip).r, farthest);
        }
    }
    return farthest <= min_bb.z;
}

bool should_descend() {
    return screen_size > min_sss;
}

// Asks the CPU for the node's children, once per node and up to the frame's
// request limit; nodes out of sight get at most a third of it, so what is in
// view refines first.
void add_request(inout Node node, bool visible) {
    if (has_requested(node) || request_index.x >= request_limit) {
        return;
    }
    if (!visible && atomicAdd(request_index.y, 1u) >= request_limit / 3u) {
        return;
    }
    uint index = atomicAdd(request_index.x, 1u);
    if (index < MAX_REQUESTS) {
        request_queue[index] = node.raw_pos;
        mark_requested(node);
    }
}

void enqueue_children(Node node) {
    if (!has_children(node) || node.child_ptr == EMPTY_ID) {
        return;
    }
    uint count = child_count(node);
    push_nodes_init(count);
    for (uint i = 0u; i < count; i++) {
        push_node(node.child_ptr + i);
    }
}

void enqueue_render(Node node) {
    if (section_count < MAX_LISTED) {
        last_render_frame[node.id] = frame_id;
        if (node.mesh != EMPTY_ID) {
            uint index = atomicAdd(section_count, 1u);
            if (index < MAX_LISTED) {
                render_list[index] = node.mesh;
            }
        }
    }
}

vec3 closest_point(vec3 eye_relative, float scale) {
    return mix(mix(vec3(0.0), eye_relative, greaterThan(eye_relative, vec3(0.0))),
        eye_relative + scale, lessThan(eye_relative + scale, vec3(0.0)));
}

vec3 furthest_point(vec3 eye_relative, float scale) {
    return mix(eye_relative + scale, mix(eye_relative, vec3(0.0), greaterThan(eye_relative, vec3(0.0))),
        lessThan(eye_relative + scale, vec3(0.0)));
}

bool within_render_distance(Node node) {
    vec3 close = closest_point(section_relative(node) - camera_sub_pos, float(32 << node.level));
    return close.x * close.x + close.z * close.z <= render_distance;
}

void traverse(inout Node node) {
    setup_screenspace(node);
    if (request_culled) {
        return;
    }
    bool visible = !frustum_culled && !culled_by_hiz();
    if (node.level != 0u && should_descend()) {
        if (has_children(node)) {
            enqueue_children(node);
        } else {
            add_request(node, visible);
            // Drawn meanwhile when wholly within reach, with a buffer room of
            // 16 cubed.
            vec3 far = furthest_point(section_relative(node) - camera_sub_pos, float(32 << node.level));
            if (visible && far.x * far.x + far.z * far.z + 16.0 * 16.0 * 16.0 <= render_distance) {
                enqueue_render(node);
            }
        }
    } else if (has_mesh(node)) {
        if (visible) {
            enqueue_render(node);
        }
    } else {
        // Wanted but not meshed yet: ask, and draw the children meanwhile.
        add_request(node, visible);
        if (node.level != 0u) {
            enqueue_children(node);
        }
    }
}

void main() {
    uint id = current_node();
    if (id == OUT_OF_BOUNDS) {
        return;
    }
    Node node = unpack_node(id);
    if (within_render_distance(node)) {
        traverse(node);
    }
}

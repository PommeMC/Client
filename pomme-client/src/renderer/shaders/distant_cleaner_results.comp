#version 450

// The sorted ids become their nodes' keys for the CPU (all ones for a freed
// node) beside the ids, which the CPU checks still hold those nodes; each
// node's last render frame pushed 60 frames ahead so it isn't picked again
// at once. The sentinel the output started filled with keeps its frame (a
// departure: the reference pushes it too, and as frames pass its stale frame
// bars every node drawn since from the sort).

#include "distant_consts.glsl"

#define OUTPUT_SIZE CLEANER_OUTPUT

layout(local_size_x = OUTPUT_SIZE) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer MinVisibility {
    uint min_vis_ids[OUTPUT_SIZE];
};

layout(set = 0, binding = 1, std430) readonly restrict buffer NodeData {
    uvec4 nodes[];
};

layout(set = 0, binding = 2, std430) writeonly restrict buffer Output {
    uvec4 output_keys[OUTPUT_SIZE];
};

layout(set = 0, binding = 3, std430) writeonly restrict buffer LastRenderFrame {
    uint last_render_frame[];
};

layout(push_constant) uniform ResultsPc {
    uint frame_id;
};

void main() {
    uint id = min_vis_ids[gl_LocalInvocationID.x];
    uvec4 node = nodes[id];
    uvec2 key = node == uvec4(0xFFFFFFFFu) ? uvec2(0xFFFFFFFFu) : node.xy;
    output_keys[gl_LocalInvocationID.x] = uvec4(key, id, 0u);
    if (id != CLEANER_SENTINEL) {
        last_render_frame[id] = frame_id + 60u;
    }
}

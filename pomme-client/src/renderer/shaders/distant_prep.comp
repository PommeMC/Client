#version 450

// Before the command generation: its dispatch size from the render list, the
// draw counts back to zero, and the occlusion pass's draw: a box per listed
// section, from the cube indices after the quads' in the shared index
// buffer.

layout(local_size_x = 1) in;

#define DISTANT_SET 0
#define DRAW_COUNTS_BINDING 0
#define RENDER_LIST_BINDING 1
#include "distant_section.glsl"

void main() {
    cmdgen_dispatch = uvec3((section_count + 127u) / 128u, 1u, 1u);
    opaque_draw_count = 0u;
    translucent_draw_count = 0u;
    temporal_draw_count = 0u;
    cull_draw.count = 36u;
    cull_draw.instance_count = section_count;
    cull_draw.first_index = QUADS_PER_DRAW * 6u;
    cull_draw.base_vertex = 0;
    cull_draw.base_instance = 0u;
}

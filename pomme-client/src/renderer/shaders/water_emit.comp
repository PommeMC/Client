#version 450

// Writes the water draw commands into their distance-bucket slots: candidates
// come from cull.comp, offsets from water_scan.comp. Bucket order is reverse
// distance, so ascending command index draws back-to-front.

#include "chunk_meta.glsl"
#include "frustum.glsl"

layout(local_size_x = 64) in;
struct DrawCmd {
    uint count_x;
    uint count_y;
    uint count_z_or_first_vertex;
    uint batch_word;
};

layout(set = 0, binding = 0) readonly buffer MetaBuf {
    ChunkMeta chunks[];
};

// Offsets after the scan; atomicAdd doubles them as per-bucket cursors. The
// slot past the buckets is the candidate count.
layout(set = 0, binding = 18) buffer WaterBuckets {
    uint water_buckets[];
};

layout(set = 0, binding = 19) readonly buffer WaterCandidates {
    uint water_candidates[];
};

layout(set = 0, binding = 20) writeonly buffer WaterIndirect {
    DrawCmd water_draws[];
};
layout(set = 0, binding = 22, std430) readonly buffer MeshBuf { uint mesh_data[]; };
#include "batch_cull.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= water_buckets[WATER_BUCKETS]) return;

    uint packed = water_candidates[i];
    uint slot = packed >> 9;
    uint bucket = packed & 0x1FFu;
    ChunkMeta m = chunks[slot];

    const uint BATCH_WORDS = 16u;
    uint fluid_start = m.solid_batch_count;
    for (uint j = 0u; j < m.fluid_batch_count; ++j) {
        uint batch_word = m.batch_word_offset + (fluid_start + j) * BATCH_WORDS;
        DrawCmd d;
        uint face_count = batch_face_count(batch_word);
        d.count_x = face_count * 6u;
        d.count_y = 1u;
        d.count_z_or_first_vertex = 0u;
        d.batch_word = batch_word;
        uint out_index = atomicAdd(water_buckets[bucket], 1u);
        if (out_index < draw_capacity) water_draws[out_index] = d;
    }
}

#version 450

// Writes the water draw commands into their distance-bucket slots: candidates
// come from cull.comp, offsets from water_scan.comp. Bucket order is reverse
// distance, so ascending command index draws back-to-front.

#include "chunk_meta.glsl"
#include "frustum.glsl"

layout(local_size_x = 64) in;

struct DrawCmd {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
};

layout(set = 0, binding = 0) readonly buffer MetaBuf {
    ChunkMeta chunks[];
};

// Offsets after the scan; atomicAdd doubles them as per-bucket cursors. The
// slot past the buckets is the candidate count.
layout(set = 0, binding = 7) buffer WaterBuckets {
    uint water_buckets[];
};

layout(set = 0, binding = 8) readonly buffer WaterCandidates {
    uint water_candidates[];
};

layout(set = 0, binding = 9) writeonly buffer WaterIndirect {
    DrawCmd water_draws[];
};
layout(set = 0, binding = 11, std430) readonly buffer MeshBuf { uint mesh_data[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= water_buckets[WATER_BUCKETS]) return;

    uint packed = water_candidates[i];
    uint slot = packed >> 9;
    uint bucket = packed & 0x1FFu;
    ChunkMeta m = chunks[slot];

    const uint BATCH_WORDS = 8u;
    uint fluid_start = m.solid_batch_count + m.cutout_batch_count;
    for (uint j = 0u; j < m.fluid_batch_count; ++j) {
        uint batch_word = m.batch_word_offset + (fluid_start + j) * BATCH_WORDS;
        DrawCmd d;
        d.vertex_count = mesh_data[batch_word + 1u] * 6u;
        d.instance_count = 1u;
        // The vertex shader rebases this draw-local index with the batch's
        // absolute face-word offset. This avoids overflowing that offset when
        // converting it into a global six-vertices-per-face index.
        d.first_vertex = 0u;
        d.first_instance = batch_word;
        uint out_index = atomicAdd(water_buckets[bucket], 1u);
        if (out_index < draw_capacity) water_draws[out_index] = d;
    }
}

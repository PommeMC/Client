#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const bool TASK_BACKEND = false;
#include "chunk_meta.glsl"
#include "frustum.glsl"

const uint BATCH_WORDS = 16u;
struct DrawCmd { uint x; uint y; uint z_or_first; uint batch; };
layout(set=0,binding=0) readonly buffer Meta { ChunkMeta chunks[]; };
layout(set=0,binding=12) readonly buffer Visibility { uint visibility[]; };
layout(set=0,binding=13) buffer History { uint history[]; };
layout(set=0,binding=2) writeonly buffer NewSolid { DrawCmd new_solid[]; };
layout(set=0,binding=3) buffer NewSolidCount { uint new_solid_count; };
layout(set=0,binding=4) writeonly buffer NewCutout { DrawCmd new_cutout[]; };
layout(set=0,binding=5) buffer NewCutoutCount { uint new_cutout_count; };
layout(set=0,binding=18) buffer WaterBuckets { uint water_buckets[]; };
layout(set=0,binding=19) writeonly buffer WaterCandidates { uint water_candidates[]; };
layout(set=0,binding=22) readonly buffer MeshBuf { uint mesh_data[]; };
layout(set=0,binding=23) buffer Stats { uint visible_sections; uint seed_sections; uint new_sections; uint _s; };
#include "batch_cull.glsl"

void emit(uint word, bool cutout) {
    if (!TASK_BACKEND && batch_backfacing(word)) return;
    DrawCmd draw = TASK_BACKEND
        ? DrawCmd(0u, 0u, 0u, word)
        : DrawCmd(batch_face_count(word) * 6u, 1u, 0u, word);
    // See cull.comp: task dispatch clamps this count before it becomes a
    // task-workgroup count, so reserve with one atomic instead of a CAS loop.
    uint out_index = cutout
        ? atomicAdd(new_cutout_count, 1u)
        : atomicAdd(new_solid_count, 1u);
    if (out_index < draw_capacity) {
        if (cutout) new_cutout[out_index] = draw;
        else new_solid[out_index] = draw;
    }
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= chunk_count) return;
    ChunkMeta meta = chunks[index];
    bool current = visibility[index] != 0u;
    bool previous = history[index] == meta.visibility_generation;
    history[index] = current ? meta.visibility_generation : 0u;
    if (!current) return;

    atomicAdd(visible_sections, 1u);
    if (!previous) {
        atomicAdd(new_sections, 1u);
        for (uint i = 0u; i < meta.solid_batch_count; ++i) {
            emit(meta.batch_word_offset + i * BATCH_WORDS, false);
        }
        for (uint i = 0u; i < meta.cutout_batch_count; ++i) {
            emit(meta.batch_word_offset + (meta.solid_batch_count + i) * BATCH_WORDS, true);
        }
    }

    if (meta.fluid_batch_count != 0u) {
        ivec3 section = meta.origin >> 4;
        ivec3 camera = ivec3(cam_x, cam_y, cam_z) >> 4;
        int distance = abs(section.x-camera.x) + abs(section.y-camera.y) + abs(section.z-camera.z);
        uint bucket = uint(int(WATER_BUCKETS) - 1 - min(distance, int(WATER_BUCKETS) - 1));
        atomicAdd(water_buckets[bucket], meta.fluid_batch_count);
        uint candidate = atomicAdd(water_buckets[WATER_BUCKETS], 1u);
        water_candidates[candidate] = (index << 9) | bucket;
    }
}
